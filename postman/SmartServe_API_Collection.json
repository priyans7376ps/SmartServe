{
  "info": {
    "name": "SmartServe API Collection",
    "description": "API collection for SmartServe Restaurant Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"John Doe\",\n  \"phone\": \"+1234567890\",\n  \"role\": \"customer\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"your-refresh-token\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Menu",
      "item": [
        {
          "name": "Get All Menu Items",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/menu?available=true&page=1&limit=20"
          }
        },
        {
          "name": "Get Menu Item by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/menu/{item_id}"
          }
        },
        {
          "name": "Create Menu Item",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/menu",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Margherita Pizza\",\n  \"description\": \"Classic tomato and mozzarella\",\n  \"price\": 12.99,\n  \"category_id\": \"category-uuid\",\n  \"preparation_time\": 15,\n  \"is_available\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"table_id\": \"table-uuid\",\n  \"items\": [\n    {\n      \"menu_item_id\": \"item-uuid\",\n      \"quantity\": 2,\n      \"special_instructions\": \"No onions\"\n    }\n  ],\n  \"coupon_code\": \"SAVE10\"\n}"
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/orders/{order_id}"
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/orders/{order_id}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"preparing\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/cart"
          }
        },
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/cart/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"menu_item_id\": \"item-uuid\",\n  \"quantity\": 1,\n  \"notes\": \"Extra cheese\"\n}"
            }
          }
        }
      ]
    }
  ]
}

