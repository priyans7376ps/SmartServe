# SmartServe Backend Environment Configuration Example
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file or production secrets to Git.

PROJECT_NAME=SmartServe
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=replace-with-your-jwt-secret-key-in-production

# Database (Default: local SQLite; for PostgreSQL use postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./smartserve.db
DATABASE_SYNC_URL=sqlite:///./smartserve.db

# Razorpay Test Mode Credentials (Get these from your Razorpay Dashboard in Test Mode)
# Important: Use ONLY test mode keys (rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_TbRRvwqNiRyzAt
RAZORPAY_KEY_SECRET=KScM46XwUNQswRhzLFo6F0Qg
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# URLs & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:5173","http://127.0.0.1:3000"]
